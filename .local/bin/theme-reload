#!/usr/bin/env bash
# Nudge running apps to re-read the hellwal-generated colour files.
#
# Most consumers of ~/.cache/hellwal/ pick up changes on their own:
#   quickshell  - FileView { watchChanges: true }, reloads in-process
#   starship    - re-reads its config on every prompt
#   wofi        - launched fresh each time, reads --style at startup
#   fastfetch   - launched fresh each time
#   hyprland    - re-reads hyprland-colours.lua on config reload
#
# Terminals are the exception: they parse their config once at startup and
# hold it. They each need a different poke, so this centralises them.
#
# Intended to be called by hellwal's -s/--script hook, which runs after the
# templates are written. Safe to run standalone.

set -uo pipefail

# Ghostty: SIGUSR2 triggers a full config reload, which re-reads the
# `config-file = ~/.cache/hellwal/ghostty-colours` include. Without this an
# already-open window keeps the palette it started with, which is why a
# wallpaper change appeared to skip the terminal.
if pgrep -x ghostty >/dev/null 2>&1; then
  pkill -USR2 -x ghostty && echo "theme-reload: ghostty reloaded"
fi

# Kitty uses SIGUSR1 for the same purpose.
if pgrep -x kitty >/dev/null 2>&1; then
  pkill -USR1 -x kitty && echo "theme-reload: kitty reloaded"
fi

# Alacritty watches its config file, so touching it is enough. Only meaningful
# if the config actually imports the hellwal output.
if pgrep -x alacritty >/dev/null 2>&1 && [[ -f ~/.config/alacritty/alacritty.toml ]]; then
  touch ~/.config/alacritty/alacritty.toml && echo "theme-reload: alacritty touched"
fi

# qt6ct (Qt6 apps, incl. the xdg-desktop-portal-hyprland share picker) reads
# its stylesheet (~/.cache/hellwal/qt6ct.qss) at startup. The picker is
# spawned fresh for every share request, so it picks up the new QSS on its
# own; no poke needed. Persistent Qt6 apps would need a restart to restyle.

# Push the current wallpaper + hellwal colours to the SDDM greeter's shared
# dir, so the login screen always matches the last wallpaper set this session.
if [[ -x ~/.local/bin/sddm-sync ]]; then
  ~/.local/bin/sddm-sync
fi

exit 0

#!/usr/bin/env bash
# Report display state as one JSON line for the quickshell Display panel.
#
#   { focusedMonitor, scale, displays: [ { name, width, height, scale,
#     focused, enabled } ] }
#
# Disabled monitors do not appear in `hyprctl monitors`, so `enabled` is true
# for anything reported. Polled by services/Display.qml every few seconds
# while the shell is up; the query is a couple of milliseconds.

set -uo pipefail

hyprctl monitors -j 2>/dev/null | jq -c '{
  focusedMonitor: ((.[] | select(.focused == true) | .name) // ""),
  scale: (((.[] | select(.focused == true) | .scale) // 1) | tostring),
  displays: ([ .[] | {
    name,
    width,
    height,
    scale,
    focused,
    enabled: true
  } ])
}'

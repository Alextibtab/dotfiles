{
    // Generated by hellwal from templates/fastfetch.jsonc - do not edit here.
    //
    // Colours are ANSI palette NAMES, not hex, and that is deliberate.
    //
    // An ANSI name emits an indexed escape (cyan -> \e[36m) which the terminal
    // resolves against its own palette at *render* time. Because hellwal also
    // generates ghostty's palette, "cyan" already means "hellwal color6" - so
    // the colours still follow the wallpaper, and any fastfetch output already
    // sitting in the scrollback RE-COLOURS when ghostty reloads its palette.
    //
    // Hex would emit truecolor (\e[38;2;r;g;bm) with the RGB baked in at print
    // time. That pins the colour forever: old output never updates, and it is
    // also easy to pick a slot that turns out unreadable. hellwal's color1 is
    // #100000 on the current wallpaper - 1.02:1 against the background, i.e.
    // invisible. color6 has been reliably bright across every palette tested
    // (7.09:1 here), which is why the original config chose cyan.
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "   ",
        "color": {
            "separator": "1"
        },
        "constants": [
            "───────────────────────"
        ],
        "key": {
            "type": "both"
        }
    },
    "logo": {
        "type": "small",
        "padding": {
            "top": 4,
            "left": 3
        },
        "color": {
            "1": "cyan",
            "2": "white"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "            {user-name-colored}{at-symbol-colored}{host-name-colored}\n"
        },
        {
            "key": "OS           ",
            "keyColor": "cyan",
            "type": "os"
        },
        {
            "key": "Machine      ",
            "keyColor": "cyan",
            "type": "host"
        },
        {
            "key": "Kernel       ",
            "keyColor": "cyan",
            "type": "kernel"
        },
        {
            "key": "Uptime       ",
            "keyColor": "cyan",
            "type": "uptime"
        },
        {
            "key": "Resolution   ",
            "keyColor": "cyan",
            "type": "display",
            "compactType": "original-with-refresh-rate"
        },
        {
            "key": "WM           ",
            "keyColor": "cyan",
            "type": "wm"
        },
        {
            "key": "DE           ",
            "keyColor": "cyan",
            "type": "de"
        },
        {
            "key": "Shell        ",
            "keyColor": "cyan",
            "type": "shell"
        },
        {
            "key": "Terminal     ",
            "keyColor": "cyan",
            "type": "terminal",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█ {#30}█{#90}█"
        },
        {
            "key": "CPU          ",
            "keyColor": "cyan",
            "type": "cpu"
        },
        {
            "key": "GPU          ",
            "keyColor": "cyan",
            "type": "gpu"
        },
        {
            "key": "Memory       ",
            "keyColor": "cyan",
            "type": "memory"
        }
    ]
}

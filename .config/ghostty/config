# Load dynamic colors from hellwal
config-file = "~/.cache/hellwal/ghostty-colours"

shell-integration = zsh
confirm-close-surface = false
resize-overlay = never

font-family = SpaceMono Nerd Font Mono
font-family-bold = SpaceMono Nerd Font Mono
font-family-italic = SpaceMono Nerd Font Mono
font-family-bold-italic = SpaceMono Nerd Font Mono
font-size = 16
font-feature = -calt

background-opacity = 0.75
background-opacity-cells = true

keybind = ctrl+e=toggle_background_opacity
